<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="dev.forevereden.launcher.INTERNAL_STATUS" android:protectionLevel="signature" />
    <uses-permission android:name="dev.forevereden.launcher.INTERNAL_STATUS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="games.wfs.anothereden" />
        <package android:name="games.fed.anothereden" />
    </queries>
    <application android:allowBackup="false" android:label="ForeverEden" android:pageSizeCompat="enabled"
        android:usesCleartextTraffic="true" android:theme="@style/AppTheme">
        <activity android:name="dev.forevereden.launcher.MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="dev.forevereden.launcher.ForeverEdenVpnService" android:exported="false"
            android:foregroundServiceType="specialUse" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-authorized official profile response capture" />
        </service>
        <service android:name="dev.forevereden.launcher.NodeListenerService" android:exported="false"
            android:process=":listener" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local ForeverEden server" />
        </service>
    </application>
</manifest>
